# ── ParaBank target ───────────────────────────────────────────────────────────
# URL of the ParaBank instance under test.
# Default points to the public Parasoft demo server.
# For local Docker: http://localhost:8080/parabank
PARABANK_BASE_URL=https://parabank.parasoft.com/parabank

# ── Default credentials ───────────────────────────────────────────────────────
PARABANK_USERNAME=john
PARABANK_PASSWORD=demo

# ── Browser ───────────────────────────────────────────────────────────────────
# Set to false to watch the browser during local development.
HEADLESS=true

# ── Database (optional — DB layer tests) ──────────────────────────────────────
# Absolute path to the ParaBank SQLite file.
# Required only when running against a local Docker instance.
# Leave empty to auto-skip DB assertions when testing the public server.
PARABANK_DB_PATH=

# ── Failscope — AI failure analysis ──────────────────────────────────────────
# Provider: groq | openai | anthropic | ollama
# Leave empty → Failscope runs in offline / rule-based mode (no API cost).
FS_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── FixtureForge — AI test-data generation (optional) ────────────────────────
# Leave all empty → deterministic mode (use_ai=False, seed=42, zero cost).
# Set one key to enable AI-generated realistic fixtures in dev mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
